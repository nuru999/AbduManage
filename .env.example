APP_NAME=AbduManage
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# ---- First admin account (created by `php artisan db:seed`) ----
ADMIN_EMAIL=admin@abdumanage.test
ADMIN_PASSWORD=change-me-before-deploying
# true = also load demo students, teachers, classes and payments
SEED_DEMO=true

# ---- M-Pesa (Safaricom Daraja) ----
# sandbox | production
MPESA_ENV=sandbox
# true = fake the payment (no Safaricom call). Great for demos. MUST be false for real money.
MPESA_SIMULATE=true
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
# Sandbox test shortcode is 174379; use your own Paybill/Till in production
MPESA_SHORTCODE=174379
MPESA_PASSKEY=
# CustomerPayBillOnline (Paybill) or CustomerBuyGoodsOnline (Till)
MPESA_TRANSACTION_TYPE=CustomerPayBillOnline
# Till number only (PartyB). Leave empty for Paybill.
MPESA_PARTY_B=
# Long random string. Becomes part of the callback URL so only Safaricom can call it.
MPESA_CALLBACK_TOKEN=
# Public https URL Safaricom can reach (your deployed domain, or an ngrok URL locally)
MPESA_CALLBACK_BASE_URL=
